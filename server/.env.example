# ==============================================================================
# MediLink Backend Environment Configuration
# ==============================================================================

# Port the Express & Socket.io server listens on
PORT=5001

# Environment mode ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB Community Edition or MongoDB Compass default:
MONGO_URI=mongodb://127.0.0.1:27017/medilink
# For MongoDB Atlas Cloud:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/medilink?retryWrites=true&w=majority

# Client Origin (CORS whitelist for production)
# CLIENT_ORIGIN=http://localhost:5173
