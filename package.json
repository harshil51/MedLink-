{
  "name": "medilink-workspace",
  "version": "1.0.0",
  "description": "MediLink - Next-Generation Real-Time Telemedicine, Doctor Verification & Emergency SOS Platform",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "start:server": "npm run start --prefix server",
    "build:client": "npm run build --prefix client",
    "preview:client": "npm run preview --prefix client",
    "lint:client": "npm run lint --prefix client"
  },
  "keywords": [
    "telemedicine",
    "healthcare",
    "socketio",
    "mern-stack",
    "react19",
    "vite",
    "nodejs",
    "express5",
    "mongodb",
    "emergency-sos",
    "doctor-portal"
  ],
  "author": "Harshil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshil51/MedLink-.git"
  }
}
